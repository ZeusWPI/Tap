<% flash.each do |type, msg| %>
  <% if flash_is_notification?(type) %>
    <div class="notification <%= isLight ? 'is-light' : '' %> <%= flash_class(type) %>" data-controller="flash">
        <!-- Close button -->
        <button class="delete" data-action="flash#remove"></button>

        <!-- Message -->
        <%= msg %>
    </div>
  <% end %>
<% end %>
